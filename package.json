{
  "name": "dsh-bitwarden",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Bitwarden / Vaultwarden password vault for DeepSeek Harness: metadata-only agent tools, a use-without-reveal execution channel, and a Bitwarden-style vault page in Settings.",
  "author": "Stars-XK",
  "license": "MIT",
  "homepage": "https://github.com/Stars-XK/dsh-bitwarden#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stars-XK/dsh-bitwarden.git"
  },
  "bugs": {
    "url": "https://github.com/Stars-XK/dsh-bitwarden/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "bitwarden",
    "vaultwarden",
    "password-manager",
    "security"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dependencies": {
    "@bitwarden/cli": "2026.10.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build:client": "node client/build.mjs",
    "sync-index": "node scripts/sync-index.mjs",
    "check-index": "node scripts/sync-index.mjs --check",
    "test": "node --test test/*.test.mjs"
  }
}
